# Copy this file to .env and fill in your actual keys
# NEVER commit .env to version control

# Primary online brain (NVIDIA NIM)
NVIDIA_API_KEY=nvapi-your-nvidia-key-here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_FAST_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_REASONING_MODEL=nvidia/nemotron-3-super-120b-a12b
NVIDIA_DEEP_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# Secondary cloud fallback (also used by the existing vision path)
GEMINI_API_KEY=your-gemini-key-here
GEMINI_TEXT_MODEL=gemini-3.1-flash-lite
GEMINI_VISION_MODEL=gemini-3.1-flash-lite
GEMINI_VISION_TIMEOUT=15.0

# Local/offline brain
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=jarvis:latest
OLLAMA_KEEP_ALIVE=30s
OLLAMA_CONNECT_TIMEOUT=1.0
OLLAMA_DISCOVERY_TIMEOUT=2.0
OLLAMA_REQUEST_TIMEOUT=30.0
OLLAMA_DISCOVERY_TTL=30.0

# Legacy only; Groq and OpenRouter are not in automatic runtime routing.
# GROQ_API_KEY=
# OPENROUTER_API_KEY=

# Optional services
WEATHER_API_KEY=your-openweather-key
NEWS_API_KEY=your-newsapi-key

# Gmail (for send_email action)
GMAIL_ADDRESS=your-email@gmail.com
GMAIL_PASSWORD=your-app-password

# Spotify (for spotify_play/control actions)
SPOTIFY_CLIENT_ID=your-spotify-client-id
SPOTIFY_CLIENT_SECRET=your-spotify-secret
SPOTIFY_REDIRECT_URI=http://localhost:8888/callback

# Local paths (adjust for your system)
# TESSERACT_PATH= (optional; auto-discovers PATH and standard install locations)
# TESSERACT_PROBE_TIMEOUT=5.0
# TESSERACT_OCR_TIMEOUT=15.0
# TESSERACT_DISCOVERY_TTL=60.0
CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# Optional: Jarvis-specific
# JARVIS_MIC_INDEX=1
# USE_F5_TTS=false

# MARK VII release reliability
JARVIS_HOME_CITY=Bengaluru
JARVIS_INTERRUPT_ENERGY_FLOOR=500
JARVIS_INTERRUPT_MIN_DURATION=0.35
JARVIS_INTERRUPT_START_GRACE=0.35
JARVIS_ENABLE_EXPERIMENTAL_VIDEO_GENERATION=false
JARVIS_CONFIRM_TTL=20
JARVIS_BROWSER_TTS=false
